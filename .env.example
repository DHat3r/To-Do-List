# Copia este archivo como .env y completa los valores. El .env NUNCA se sube a git.

# Clave para firmar los tokens JWT. Genera una propia con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=cambia-esto-por-una-clave-generada

# Opcional: por defecto usa sqlite:///./tasks.db (en Docker lo fija el Dockerfile)
# DATABASE_URL=sqlite:///./tasks.db

# Opcional: puerto de tu PC para docker compose (por defecto 8000)
# API_PORT=8001
